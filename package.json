{
  "name": "reerhub-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:dev": "MONGO_DB_NAME=reerhub-dev node src/scripts/seed.js",
    "seed:prod": "MONGO_DB_NAME=reerhub-prod node src/scripts/seed.js",
    "sync:source": "node src/scripts/syncSource.js",
    "backfill": "node src/scripts/backfillCategories.js",
    "backfill:geo": "node src/scripts/backfillGeo.js",
    "test": "NODE_ENV=test node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "description": "ReerHub API and data-ingestion foundation.",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "he": "^1.2.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongo-sanitize": "^1.1.0",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
