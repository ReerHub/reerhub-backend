NODE_ENV=development
PORT=8000

# MongoDB — dev and prod MUST be different databases.
# Local dev:
#   MONGO_URI=mongodb://localhost:27017
#   MONGO_DB_NAME=reerhub-dev
# Production (Atlas example, never reuse the dev DB name):
#   MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/admin
#   MONGO_DB_NAME=reerhub-prod
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=reerhub-dev

# Redis
REDIS_URL=redis://localhost:6379

# Comma-separated allowed frontend origins (browser Origin header).
# Production (Vercel): CORS_FRONTEND_URL=https://www.reerhub.com,https://reerhub.com
CORS_FRONTEND_URL=http://localhost:3000

# Daily sync schedule override (cron). When unset, each source is
# deterministically staggered across 02:00-05:00 to avoid a thundering herd.
# SYNC_CRON=0 2 * * *

# Worker throughput: parallel source syncs per worker process.
SYNC_CONCURRENCY=5

# ATS fetch timeout in milliseconds.
ADAPTER_FETCH_TIMEOUT_MS=30000

# API key guarding write endpoints (POST /companies, /job-sources, /sync).
# When unset, writes are open (local dev). Always set in production.
# API_KEY=change-me

# Set to false to run API without the BullMQ worker (e.g. frontend-only dev)
WORKER_ENABLED=true
