NODE_ENV=development
PORT=8000

# MongoDB — dev and prod MUST be different databases.
# Local dev:
#   MONGO_URI=mongodb://localhost:27017
#   MONGO_DB_NAME=reerhub-dev
# Production (Atlas example, never reuse the dev DB name):
#   MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/admin
#   MONGO_DB_NAME=reerhub-prod
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=reerhub-dev

# Comma-separated allowed frontend origins (browser Origin header).
# Production (Vercel): CORS_FRONTEND_URL=https://www.reerhub.com,https://reerhub.com
CORS_FRONTEND_URL=http://localhost:3000

# MongoDB-backed scheduler: source syncs are staggered daily from 02:00–05:00 UTC.
# Run a single API instance while enabled. Defaults to 3 concurrent syncs.
SYNC_CONCURRENCY=3
SCHEDULER_ENABLED=true

# ATS fetch timeout in milliseconds.
ADAPTER_FETCH_TIMEOUT_MS=30000

# API key guarding write endpoints (POST /companies, /job-sources, /sync).
# When unset, writes are open (local dev). Always set in production.
# API_KEY=change-me

# Auth (JWT cookies + Google login). Always set in production.
# JWT_ACCESS_SECRET=<openssl rand -hex 32>
# JWT_REFRESH_SECRET=<openssl rand -hex 32>
# GOOGLE_CLIENT_ID=<google-cloud-console-client-id>

# Email (Resend SMTP) for verify/reset links. Log-only in dev when unset.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxx
# SMTP_FROM=ReerHub <noreply@reerhub.com>
# FRONTEND_URL=http://localhost:3000

# Bot protection (Cloudflare Turnstile) on signup + forgot-password.
# Bypassed in tests and in dev when unset. Always set in production.
# TURNSTILE_SECRET_KEY=xxxx

# Razorpay Pro subscription — 3 plans (create in Razorpay dashboard first).
# Trial is 7 days on every plan (TRIAL_DAYS in src/services/razorpay.service.js).
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_PRO_WEEKLY_PLAN_ID=plan_xxx    # ₹49/week
# RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_xxx   # ₹150/month
# RAZORPAY_PRO_QUARTERLY_PLAN_ID=plan_xxx # ₹299/3 months
# Legacy fallback for the original single plan (deprecated, remove once rotated):
# RAZORPAY_PRO_PLAN_ID=plan_xxx
# RAZORPAY_WEBHOOK_SECRET=xxx
